    "custom_liquid_dkYwBp": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.cupios-section {\n            background-color: #232323;\n            text-align: center;\n            padding: 100px 20px;\n        }\n\n        .cupios-heading {\n            font-size: 2em;\nline-height:1em;\n            font-weight: bold;\n            color: #fff;\n            margin-bottom: 10px;\n        }\n\n        .cupios-subheading {\n            font-size: 1em;\nline-height:1.15em;\n            color: #ccc;\n            margin-bottom: 30px;\n        }\n\n        .cupios-features-grid {\n            display: flex;\n            flex-direction: row;\n            flex-wrap: wrap;\n            gap: 20px;\n            max-width: 1280px;\n            margin: 0 auto;\n            justify-content: center;\n        }\n\n        .cupios-feature {\n                background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(240, 240, 240, 0.8));\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n    border: 1px solid rgba(255, 255, 255, 0.4);\n    border-radius: 12px;\n    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n\n            padding: 20px;\n            transition: transform 0.3s ease;\n            text-align: left; \n            width: 275px;\n        }\n\n        .cupios-feature:hover {\n            transform: translateY(-5px);\n        }\n\n        .cupios-feature-header {\n            display: flex;\n            align-items: center;\n            margin-bottom: 15px;\n        }\n\n        .cupios-feature-icon {\n            border-radius: 50%;\n            margin-right: 15px;\n            display: inline-block;\n            flex-shrink: 0; /* Prevent the icon from shrinking */\n        }\n\n        .cupios-feature-icon img {\n            max-width: 50px;\n            height: auto;\n        }\n\n        .cupios-feature-title {\n            font-size: 18px;\n            font-weight: 600;\n            color: #333;\n        }\n\n        .cupios-feature-text {\n            font-size: 16px;\n            color: #666;\n            line-height: 1.5;\n        }\n\n        @media (max-width: 1024px) {\n            .cupios-features-grid {\n                grid-template-columns: repeat(2, 1fr);\n            }\n        }\n\n        @media (max-width: 768px) {\n            .cupios-features-grid {\n                grid-template-columns: 1fr;\n            }\n.cupios-feature {\n    width: 350px;\n}\n        }\n    </style>\n    <div class=\"cupios-section\">\n        <div class=\"cupios-heading\">7 REASONS WHY S1CK PHEROMONES</div>\n        <div class=\"cupios-subheading\">It's time to upgrade your fragrance game with our scientifically formulated blends</div>\n\n        <div class=\"cupios-features-grid\">\n            <div class=\"cupios-feature\">\n                <div class=\"cupios-feature-header\">\n                    <div class=\"cupios-feature-icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0022/0358/2529/files/1_2f487f48-0c21-4796-b8bf-4114e31c9e2d.png?v=1724259532\" alt=\"Icon 1\">\n                    </div>\n                    <div class=\"cupios-feature-title\"> Engineered For Men & Women</div>\n                </div>\n                <div class=\"cupios-feature-text\">Crafted to boost natural pheromones in Men & Women</div>\n            </div>\n            <div class=\"cupios-feature\">\n                <div class=\"cupios-feature-header\">\n                    <div class=\"cupios-feature-icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0022/0358/2529/files/2_240a375c-7ac1-40fe-aaa1-f1288362342e.png?v=1724259532\" alt=\"Icon 2\">\n                    </div>\n                    <div class=\"cupios-feature-title\">Boosts Attraction And Confidence</div>\n                </div>\n                <div class=\"cupios-feature-text\">Formula that naturally amplifies your pheromone output</div>\n            </div>\n            <div class=\"cupios-feature\">\n                <div class=\"cupios-feature-header\">\n                    <div class=\"cupios-feature-icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0022/0358/2529/files/3_fd7e5fd7-3047-4d13-9de4-d0e66b007cf7.png?v=1724259532\" alt=\"Icon 3\">\n                    </div>\n                    <div class=\"cupios-feature-title\">Luxury At An Affordable Price</div>\n                </div>\n                <div class=\"cupios-feature-text\">We've made luxury smelling fragrances within reach for all</div>\n            </div>\n            <div class=\"cupios-feature\">\n                <div class=\"cupios-feature-header\">\n                    <div class=\"cupios-feature-icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0022/0358/2529/files/4_04486d22-2e49-418d-b4bb-d4bc712e5dc3.png?v=1724259532\" alt=\"Icon 4\">\n                    </div>\n                    <div class=\"cupios-feature-title\">100,000+ Happy Customers</div>\n                </div>\n                <div class=\"cupios-feature-text\">You're our #1 priority and we'll ensure your satisfaction</div>\n            </div>\n            <div class=\"cupios-feature\">\n                <div class=\"cupios-feature-header\">\n                    <div class=\"cupios-feature-icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0022/0358/2529/files/5_5c223888-e4b9-4bb7-9cd3-848ad498fe53.png?v=1724259532\" alt=\"Icon 5\">\n                    </div>\n                    <div class=\"cupios-feature-title\">30-Day Money-Back Guarantee</div>\n                </div>\n                <div class=\"cupios-feature-text\">Unsatisfied with the results? Send it back for a refund</div>\n            </div>\n            <div class=\"cupios-feature\">\n                <div class=\"cupios-feature-header\">\n                    <div class=\"cupios-feature-icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0022/0358/2529/files/6_e5af69fe-aa6b-4c4b-8574-fd7b299d9453.png?v=1724259532\" alt=\"Icon 6\">\n                    </div>\n                    <div class=\"cupios-feature-title\">Priority Shipping Worldwide</div>\n                </div>\n                <div class=\"cupios-feature-text\">Right to your doorstep wherever you are</div>\n            </div>\n            <div class=\"cupios-feature\">\n                <div class=\"cupios-feature-header\">\n                    <div class=\"cupios-feature-icon\">\n                        <img src=\"https://cdn.shopify.com/s/files/1/0022/0358/2529/files/7_4bb8768b-d2d7-48c8-8d5f-204628f37f44.png?v=1724259532\" alt=\"Icon 7\">\n                    </div>\n                    <div class=\"cupios-feature-title\">24/7 Customer Support</div>\n                </div>\n                <div class=\"cupios-feature-text\">Reach out via email and we'll take care of all your questions</div>\n            </div>\n        </div>\n    </div>",
