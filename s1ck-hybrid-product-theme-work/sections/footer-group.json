{"type":"footer","name":"Footer","sections":{"custom_liquid_Tdjqam":{"type":"custom-liquid","name":"Custom liquid","settings":{"custom_liquid":"<!-- VIP Club Section - Centered with Glass Effect -->\n{% unless template == 'index' %}\n<div id=\"vip-club-section\" style=\"position: relative; margin: 25px 0;\">\n  <style>\n    #vip-club-section {\n      background: #000000;\n      border: 1px solid #ffffff;\n      position: relative;\n      overflow: hidden;\n      transition: all 0.3s ease;\n      min-height: 420px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    #vip-club-section:hover {\n      border-color: #ffffff;\n      box-shadow: 0 0 25px rgba(255, 255, 255, 0.2);\n    }\n\n    \/* Background Image Layer - More Visible *\/\n    .vip-bg-image {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background-image: url('https:\/\/cdn.shopify.com\/s\/files\/1\/0022\/0358\/2529\/files\/bundle.png?v=1755504158');\n      background-size: cover;\n      background-position: center;\n      background-repeat: no-repeat;\n      opacity: 0.45;\n      z-index: 1;\n      filter: grayscale(20%) brightness(1);\n      transition: all 0.5s ease;\n      transform: scale(1.1);\n    }\n\n    #vip-club-section:hover .vip-bg-image {\n      opacity: 0.55;\n      filter: grayscale(10%) brightness(1.1);\n      transform: scale(1.15);\n    }\n\n    \/* Dark Overlay for Better Contrast *\/\n    .vip-overlay {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background: radial-gradient(\n        ellipse at center,\n        rgba(0, 0, 0, 0.4) 0%,\n        rgba(0, 0, 0, 0.7) 100%\n      );\n      z-index: 2;\n    }\n\n    \/* Glass Container for Content *\/\n    .vip-glass-container {\n      position: relative;\n      z-index: 3;\n      background: rgba(0, 0, 0, 0.3);\n      backdrop-filter: blur(5px);\n      -webkit-backdrop-filter: blur(5px);\n      border: 1px solid rgba(255, 255, 255, 0.3);\n      border-radius: 0;\n      padding: 40px 50px;\n      max-width: 600px;\n      width: 90%;\n      text-align: center;\n      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n    }\n\n    \/* Crown Icon *\/\n    .vip-crown {\n      font-size: 36px;\n      margin-bottom: 15px;\n      display: inline-block;\n      animation: float 3s ease-in-out infinite;\n      filter: grayscale(100%) brightness(2);\n    }\n\n    @keyframes float {\n      0%, 100% { transform: translateY(0px) rotate(0deg); }\n      50% { transform: translateY(-10px) rotate(5deg); }\n    }\n\n    \/* VIP Badge *\/\n    .vip-badge {\n      display: inline-block;\n      background: rgba(255, 255, 255, 0.15);\n      border: 1px solid rgba(255, 255, 255, 0.6);\n      color: #ffffff;\n      padding: 5px 15px;\n      font-size: 10px;\n      font-weight: bold;\n      letter-spacing: 3px;\n      text-transform: uppercase;\n      margin-bottom: 20px;\n      position: relative;\n    }\n\n    \/* Main Title *\/\n    .vip-title {\n      color: #ffffff;\n      font-size: 38px;\n      font-weight: 900;\n      text-transform: uppercase;\n      letter-spacing: 3px;\n      margin: 15px 0;\n      line-height: 1.1;\n      text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);\n    }\n\n    .vip-title .highlight {\n      background: linear-gradient(90deg, #ffffff, #f0f0f0, #ffffff);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      background-clip: text;\n      animation: shimmer 3s linear infinite;\n      background-size: 200% 100%;\n    }\n\n    @keyframes shimmer {\n      0% { background-position: -200% center; }\n      100% { background-position: 200% center; }\n    }\n\n    \/* Percentage Display *\/\n    .vip-percentage {\n      font-size: 52px;\n      font-weight: 900;\n      color: #ffffff;\n      margin: 25px 0;\n      letter-spacing: 2px;\n      text-shadow: 3px 3px 10px rgba(0, 0, 0, 0.9);\n      animation: pulse 2s ease-in-out infinite;\n      position: relative;\n    }\n\n    @keyframes pulse {\n      0%, 100% { transform: scale(1); }\n      50% { transform: scale(1.08); }\n    }\n\n    .vip-percentage .percent-number {\n      color: #ffffff;\n      position: relative;\n      display: inline-block;\n    }\n\n    .vip-percentage .percent-number::after {\n      content: '35%';\n      position: absolute;\n      top: 3px;\n      left: 3px;\n      color: rgba(255, 255, 255, 0.2);\n      z-index: -1;\n    }\n\n    \/* Subtitle *\/\n    .vip-subtitle {\n      color: rgba(255, 255, 255, 0.85);\n      font-size: 14px;\n      text-transform: uppercase;\n      letter-spacing: 1.5px;\n      margin-bottom: 30px;\n      line-height: 1.6;\n    }\n\n    \/* CTA Button *\/\n    .vip-cta {\n      display: inline-block;\n      background: #ffffff;\n      color: #000000;\n      padding: 15px 45px;\n      text-decoration: none;\n      font-weight: bold;\n      font-size: 14px;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      position: relative;\n      overflow: hidden;\n      transition: all 0.3s ease;\n      border: 2px solid #ffffff;\n    }\n\n    .vip-cta:hover {\n      background: transparent;\n      color: #ffffff;\n      transform: translateY(-3px);\n      box-shadow: 0 10px 25px rgba(255, 255, 255, 0.3);\n    }\n\n    .vip-cta span {\n      position: relative;\n      z-index: 2;\n    }\n\n    .vip-cta::before {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: -100%;\n      width: 100%;\n      height: 100%;\n      background: #000000;\n      transition: left 0.3s ease;\n      z-index: 1;\n    }\n\n    .vip-cta:hover::before {\n      left: 0;\n    }\n\n    \/* Animated Golden Particles *\/\n    .golden-particle {\n      position: absolute;\n      width: 4px;\n      height: 4px;\n      background: radial-gradient(circle, #ffd700, #ffed4e);\n      border-radius: 50%;\n      opacity: 0;\n      z-index: 4;\n      box-shadow: 0 0 8px #ffd700;\n    }\n\n    @keyframes golden-float {\n      0% {\n        opacity: 0;\n        transform: translateY(100px) translateX(0) scale(0);\n      }\n      20% {\n        opacity: 0.8;\n        transform: translateY(80px) translateX(-20px) scale(1);\n      }\n      80% {\n        opacity: 0.8;\n        transform: translateY(20px) translateX(20px) scale(1);\n      }\n      100% {\n        opacity: 0;\n        transform: translateY(0) translateX(0) scale(0.5);\n      }\n    }\n\n    .golden-particle:nth-child(1) { left: 10%; animation: golden-float 6s infinite; }\n    .golden-particle:nth-child(2) { left: 25%; animation: golden-float 6s infinite 1s; }\n    .golden-particle:nth-child(3) { left: 50%; animation: golden-float 6s infinite 2s; }\n    .golden-particle:nth-child(4) { left: 75%; animation: golden-float 6s infinite 3s; }\n    .golden-particle:nth-child(5) { left: 90%; animation: golden-float 6s infinite 4s; }\n    .golden-particle:nth-child(6) { left: 15%; animation: golden-float 6s infinite 2.5s; }\n    .golden-particle:nth-child(7) { left: 60%; animation: golden-float 6s infinite 3.5s; }\n    .golden-particle:nth-child(8) { left: 85%; animation: golden-float 6s infinite 4.5s; }\n\n    \/* Corner Accents on Glass Container *\/\n    .glass-corner {\n      position: absolute;\n      width: 25px;\n      height: 25px;\n      border: 1px solid rgba(255, 255, 255, 0.6);\n    }\n\n    .glass-corner.top-left {\n      top: -1px;\n      left: -1px;\n      border-right: none;\n      border-bottom: none;\n    }\n\n    .glass-corner.top-right {\n      top: -1px;\n      right: -1px;\n      border-left: none;\n      border-bottom: none;\n    }\n\n    .glass-corner.bottom-left {\n      bottom: -1px;\n      left: -1px;\n      border-right: none;\n      border-top: none;\n    }\n\n    .glass-corner.bottom-right {\n      bottom: -1px;\n      right: -1px;\n      border-left: none;\n      border-top: none;\n    }\n\n    \/* Responsive Design *\/\n    @media (max-width: 768px) {\n      #vip-club-section {\n        min-height: 450px;\n      }\n      \n      .vip-glass-container {\n        padding: 30px 25px;\n        width: 95%;\n      }\n      \n      .vip-title { font-size: 28px; }\n      .vip-percentage { font-size: 42px; }\n      .vip-subtitle { font-size: 12px; }\n      .vip-cta { padding: 12px 35px; }\n    }\n\n    \/* Glitch Effect on Hover *\/\n    @keyframes glitch {\n      0%, 100% { \n        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);\n      }\n      25% { \n        text-shadow: -2px 2px 8px rgba(255, 215, 0, 0.3), \n                     2px 2px 8px rgba(0, 0, 0, 0.9);\n      }\n      50% { \n        text-shadow: 2px -2px 8px rgba(255, 215, 0, 0.3), \n                     2px 2px 8px rgba(0, 0, 0, 0.9);\n      }\n    }\n\n    .vip-title:hover {\n      animation: glitch 0.3s ease-in-out;\n    }\n\n    \/* Premium Border Animation *\/\n    #vip-club-section::before {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      bottom: 0;\n      background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.15), transparent);\n      transform: translateX(-100%);\n      animation: border-shine 8s infinite;\n      z-index: 1;\n      pointer-events: none;\n    }\n\n    @keyframes border-shine {\n      0% { transform: translateX(-100%); }\n      50%, 100% { transform: translateX(200%); }\n    }\n  <\/style>\n\n  <!-- Background Image Layer -->\n  <div class=\"vip-bg-image\"><\/div>\n  \n  <!-- Dark Overlay -->\n  <div class=\"vip-overlay\"><\/div>\n  \n  <!-- Golden Particles -->\n  <div class=\"golden-particle\"><\/div>\n  <div class=\"golden-particle\"><\/div>\n  <div class=\"golden-particle\"><\/div>\n  <div class=\"golden-particle\"><\/div>\n  <div class=\"golden-particle\"><\/div>\n  <div class=\"golden-particle\"><\/div>\n  <div class=\"golden-particle\"><\/div>\n  <div class=\"golden-particle\"><\/div>\n\n  <!-- Glass Container with Content -->\n  <div class=\"vip-glass-container\">\n    <!-- Corner Accents -->\n    <div class=\"glass-corner top-left\"><\/div>\n    <div class=\"glass-corner top-right\"><\/div>\n    <div class=\"glass-corner bottom-left\"><\/div>\n    <div class=\"glass-corner bottom-right\"><\/div>\n\n    <!-- Content -->\n    <div class=\"vip-crown\">👑<\/div>\n    <div class=\"vip-badge\">Exclusive Access<\/div>\n    \n    <h3 class=\"vip-title\">\n      Join The <span class=\"highlight\">VIP CLUB<\/span>\n    <\/h3>\n    \n    <div class=\"vip-percentage\">\n      UP TO <span class=\"percent-number\">35%<\/span> OFF\n    <\/div>\n    \n    <div class=\"vip-subtitle\">\n      Premium fragrances delivered monthly<br>\n      Exclusive member-only collections\n    <\/div>\n    \n    <a href=\"https:\/\/s1ckshop.com\/pages\/monthly-box\" class=\"vip-cta\">\n      <span>Unlock VIP Status →<\/span>\n    <\/a>\n  <\/div>\n<\/div>\n\n<!-- Enhanced JavaScript -->\n<script>\n  \/\/ Number counting animation\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        const percentElement = entry.target.querySelector('.percent-number');\n        if (percentElement && !percentElement.classList.contains('counted')) {\n          percentElement.classList.add('counted');\n          let current = 0;\n          const target = 35;\n          const increment = target \/ 30;\n          const timer = setInterval(() => {\n            current += increment;\n            if (current >= target) {\n              current = target;\n              clearInterval(timer);\n            }\n            percentElement.textContent = Math.floor(current) + '%';\n          }, 40);\n        }\n      }\n    });\n  });\n\n  const vipSection = document.getElementById('vip-club-section');\n  if (vipSection) {\n    observer.observe(vipSection);\n  }\n\n  \/\/ Parallax effect on mouse move\n  vipSection.addEventListener('mousemove', function(e) {\n    const rect = this.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    const y = e.clientY - rect.top;\n    const centerX = rect.width \/ 2;\n    const centerY = rect.height \/ 2;\n    const deltaX = (x - centerX) \/ centerX;\n    const deltaY = (y - centerY) \/ centerY;\n    \n    const bgImage = this.querySelector('.vip-bg-image');\n    if (bgImage) {\n      bgImage.style.transform = `scale(1.15) translate(${deltaX * 15}px, ${deltaY * 15}px)`;\n    }\n  });\n\n  vipSection.addEventListener('mouseleave', function() {\n    const bgImage = this.querySelector('.vip-bg-image');\n    if (bgImage) {\n      bgImage.style.transform = 'scale(1.1)';\n    }\n  });\n<\/script>\n{% endunless %}","custom_class":""}},"icon_box_dr4JGr":{"type":"icon-box","blocks":{"iconbox_icLnDE":{"type":"iconbox","settings":{"image":"shopify:\/\/shop_images\/bundle.png","image_by_url":"","title":"CHOOSE FROM OUR 4 PLANS","description":"<p>Any 10ml Spray<\/p>","link":"https:\/\/s1ckshop.com\/pages\/monthly-box","button_label":"","button_link":"","button_style":"m-button--link","button_size":""}}},"block_order":["iconbox_icLnDE"],"disabled":true,"custom_css":[],"name":"Featured promotion","settings":{"heading":"SUBSCRIBE NOW AND SAVE UP T0 35%","heading_size":"h3","subheading":"Choose Your Weapon","description":"","header_alignment":"center","container":"container-fluid","color_scheme":"","item_per_row":3,"item_gap":30,"item_gap_mobile":10,"card_color_scheme":"","card_style":"vertical","image_max_width":"","content_alignment":"center","hover_effect":"scaling-up","enable_slider":false,"show_pagination":false,"show_navigation":false,"use_scroll_mobile":true,"use_grid_column_mb":false,"padding_top":0,"padding_bottom":0,"custom_class":"","animations":"inherit"}},"footer":{"type":"footer","blocks":{"7b0bf4c6-3873-4222-b8d6-ce009e710078":{"type":"newsletter","settings":{"title":"Let’s get in touch","description":"Sign up for our newsletter and receive 10% off your first order","email_placeholder":"Enter your email","show_icon_input":false,"button_label":"Subscribe no