x-shadow:0 2px 18px #2222;padding:44px 28px 32px 28px;text-align:center;display:flex;flex-direction:column;align-items:center;\">\n        <div style=\"font-size:2.5em;margin-bottom:18px;\">🔥<\/div>\n        <div style=\"font-weight:700;font-size:1.23em;margin-bottom:9px;color:#181818;\">Enjoy, Switch, or Pause<\/div>\n        <div style=\"font-size:1.08em;color:#333;line-height:1.45;\">Try new drops every month and reactivate, skip, or pause anytime. No contracts, just new vibes!<\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/div>","custom_class":""}},"custom_liquid_PnwJUw":{"type":"custom-liquid","name":"Custom liquid","settings":{"custom_liquid":"<style>\n  .review-section {\n    background: #151414;\n    padding: 50px 20px;\n    color: #fff;\n  }\n\n  .review-section h2 {\n    text-align: center;\n    font-size: 2rem;\n    margin-bottom: 30px;\n    font-weight: bold;\n    color: #ffffff; \/* Make heading white *\/\n  }\n\n  .review-carousel {\n    display: flex;\n    gap: 20px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    padding-bottom: 10px;\n  }\n\n  .review-card {\n    background: #222;\n    border-radius: 14px;\n    padding: 20px;\n    min-width: 280px;\n    max-width: 300px;\n    flex: 0 0 auto;\n    scroll-snap-align: start;\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);\n  }\n\n  .review-card .stars {\n    color: #fcd34d;\n    margin-bottom: 10px;\n  }\n\n  .review-card p {\n    font-size: 0.95rem;\n    line-height: 1.5;\n    margin-bottom: 10px;\n  }\n\n  .reviewer {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    margin-top: 10px;\n  }\n\n  .reviewer img {\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    object-fit: cover;\n  }\n\n  .reviewer-name {\n    font-weight: bold;\n    font-size: 0.95rem;\n  }\n\n  \/* Optional scrollbar styling *\/\n  .review-carousel::-webkit-scrollbar {\n    height: 8px;\n  }\n\n  .review-carousel::-webkit-scrollbar-thumb {\n    background: #888;\n    border-radius: 4px;\n  }\n\n  .review-carousel::-webkit-scrollbar-thumb:hover {\n    background: #555;\n  }\n<\/style>\n\n<section class=\"review-section\">\n  <h2>What Customers Are Saying<\/h2>\n  <div class=\"review-carousel\">\n\n    <!-- Review 1 -->\n    <div class=\"review-card\">\n      <div class=\"stars\">★★★★★<\/div>\n      <p>“This scent is absolutely insane! I got compliments all night. Definitely becoming my go-to.”<\/p>\n      <div class=\"reviewer\">\n        <img src=\"https:\/\/randomuser.me\/api\/portraits\/women\/44.jpg\" alt=\"Reviewer\">\n        <div class=\"reviewer-name\">Jade P.<\/div>\n      <\/div>\n    <\/div>\n\n    <!-- Review 2 -->\n    <div class=\"review-card\">\n      <div class=\"stars\">★★★★★<\/div>\n      <p>“I was skeptical, but wow... the roll-on oil is a game-changer. I feel confident and sexy.”<\/p>\n      <div class=\"reviewer\">\n        <img src=\"https:\/\/randomuser.me\/api\/portraits\/men\/32.jpg\" alt=\"Reviewer\">\n        <div class=\"reviewer-name\">Andre L.<\/div>\n      <\/div>\n    <\/div>\n\n    <!-- Review 3 -->\n    <div class=\"review-card\">\n      <div class=\"stars\">★★★★☆<\/div>\n      <p>“Loved the scent, though shipping took a few extra days. Still totally worth the wait!”<\/p>\n      <div class=\"reviewer\">\n        <img src=\"https:\/\/randomuser.me\/api\/portraits\/women\/68.jpg\" alt=\"Reviewer\">\n        <div class=\"reviewer-name\">Emily R.<\/div>\n      <\/div>\n    <\/div>\n\n    <!-- Review 4 -->\n    <div class=\"review-card\">\n      <div class=\"stars\">★★★★★<\/div>\n      <p>“I’ve tried a few pheromone perfumes before, but this one really hits. Subtle but powerful.”<\/p>\n      <div class=\"reviewer\">\n        <img src=\"https:\/\/randomuser.me\/api\/portraits\/men\/85.jpg\" alt=\"Reviewer\">\n        <div class=\"reviewer-name\">Marcus G.<\/div>\n      <\/div>\n    <\/div>\n\n    <!-- Review 5 -->\n    <div class=\"review-card\">\n      <div class=\"stars\">★★★★★<\/div>\n      <p>“Repeat customer here. These scents never miss. Even my boyfriend steals them.”<\/p>\n      <div class=\"reviewer\">\n        <img src=\"https:\/\/randomuser.me\/api\/portraits\/women\/22.jpg\" alt=\"Reviewer\">\n        <div class=\"reviewer-name\">Tasha B.<\/div>\n      <\/div>\n    <\/div>\n\n  <\/div>\n<\/section>","custom_class":""}},"page_faqs_a7WP4k":{"type":"page-faqs","blocks":{"accordion_fwR3KK":{"type":"accordion","settings":{"title":"How does the S1CKSHOP subscription work?","content":"<p>Each month, you'll receive a fresh, curated scent (or multiple) delivered straight to your door. Simply pick your tier—The Tease, Double Dose, The Arsenal, or Black Label Access—and enjoy exclusive formulas, early access, and club-only perks.<br\/><\/p>","open":false}},"accordion_4H3GV9":{"type":"accordion","settings":{"title":"Can I skip a month or cancel anytime?","content":"<p>Absolutely! Our subscriptions are fully flexible. You can pause, skip, change your tier, or cancel anytime through your account dashboard. No penalties, no hassle, ever.<\/p>","open":false}},"accordion_3FwCdY":{"type":"accordion","settings":{"title":"Do I get the same scent every month?","content":"<p>No repeats for at least three months! Each shipment is curated to deliver you new and exciting formulas. With higher tiers, you get even more variety and access to exclusive blends.<\/p>","open":false}},"accordion_BU64id":{"type":"accordion","settings":{"title":"Who are S1CKSHOP fragrances for?","content":"<p>Our formulas are crafted to be universally appealing and wearable—designed for all genders, with club-exclusive drops and special editions to suit every personality and occasion.<\/p>","open":false}}},"block_order":["accordion_fwR3KK","accordion_4H3GV9","accordion_3FwCdY","accordion_BU64id"],"name":"FAQs","settings":{"container":"container","color_scheme":"","menu":"","custom_class":""}},"page_faqs_kiXhfL":{"type":"page-faqs","blocks":{"accordion_g4ijW7":{"type":"accordio