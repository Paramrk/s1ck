e: 11px;\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      margin-bottom: 8px;\n      animation: flash 2s infinite;\n    }\n\n    @keyframes flash {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.7; }\n    }\n\n    .promo-title {\n      color: #ffffff;\n      font-size: 18px;\n      font-weight: bold;\n      margin: 8px 0;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      text-shadow: 0 0 10px rgba(255, 0, 0, 0.5);\n    }\n\n    .promo-subtitle {\n      color: #cccccc;\n      font-size: 13px;\n      margin-bottom: 12px;\n      opacity: 0.9;\n    }\n\n    .promo-link {\n      display: inline-block;\n      background: linear-gradient(45deg, #ff0000, #cc0000);\n      color: #ffffff;\n      padding: 10px 25px;\n      text-decoration: none;\n      border-radius: 25px;\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      transition: all 0.3s ease;\n      position: relative;\n      overflow: hidden;\n      font-size: 14px;\n    }\n\n    .promo-link:hover {\n      transform: scale(1.05);\n      box-shadow: 0 5px 20px rgba(255, 0, 0, 0.4);\n      background: linear-gradient(45deg, #ff3333, #ff0000);\n    }\n\n    .promo-link::before {\n      content: '';\n      position: absolute;\n      top: -2px;\n      left: -2px;\n      right: -2px;\n      bottom: -2px;\n      background: linear-gradient(45deg, #ff0000, #ffffff, #ff0000);\n      border-radius: 25px;\n      opacity: 0;\n      z-index: -1;\n      transition: opacity 0.3s ease;\n      animation: shimmer 3s linear infinite;\n    }\n\n    @keyframes shimmer {\n      0% { transform: translateX(-100%); }\n      100% { transform: translateX(100%); }\n    }\n\n    .promo-link:hover::before {\n      opacity: 0.3;\n    }\n\n    \/* Animated Particles *\/\n    .particle {\n      position: absolute;\n      pointer-events: none;\n      opacity: 0;\n      z-index: 1;\n    }\n\n    .particle::before {\n      content: '▪';\n      color: #ff0000;\n      font-size: 8px;\n      text-shadow: 0 0 6px #ff0000;\n    }\n\n    @keyframes float-up {\n      0% {\n        opacity: 0;\n        transform: translateY(0) translateX(0) scale(0);\n      }\n      10% {\n        opacity: 1;\n        transform: translateY(-10px) translateX(10px) scale(1);\n      }\n      100% {\n        opacity: 0;\n        transform: translateY(-100px) translateX(30px) scale(0.3);\n      }\n    }\n\n    .particle:nth-child(1) { left: 10%; animation: float-up 4s infinite; }\n    .particle:nth-child(2) { left: 20%; animation: float-up 4s infinite 0.5s; }\n    .particle:nth-child(3) { left: 30%; animation: float-up 4s infinite 1s; }\n    .particle:nth-child(4) { left: 40%; animation: float-up 4s infinite 1.5s; }\n    .particle:nth-child(5) { left: 50%; animation: float-up 4s infinite 2s; }\n    .particle:nth-child(6) { left: 60%; animation: float-up 4s infinite 2.5s; }\n    .particle:nth-child(7) { left: 70%; animation: float-up 4s infinite 3s; }\n    .particle:nth-child(8) { left: 80%; animation: float-up 4s infinite 3.5s; }\n    .particle:nth-child(9) { left: 90%; animation: float-up 4s infinite 4s; }\n\n    \/* Skull Icon *\/\n    .skull-icon {\n      display: inline-block;\n      vertical-align: middle;\n      margin: 0 5px;\n      font-size: 16px;\n      animation: rotate 4s linear infinite;\n    }\n\n    @keyframes rotate {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n\n    \/* Responsive adjustments *\/\n    @media (max-width: 768px) {\n      .promo-title { font-size: 16px; }\n      .promo-subtitle { font-size: 12px; }\n      .promo-link { padding: 8px 20px; font-size: 13px; }\n    }\n  <\/style>\n\n  <!-- Animated Particles -->\n  <div class=\"particle\"><\/div>\n  <div class=\"particle\"><\/div>\n  <div class=\"particle\"><\/div>\n  <div class=\"particle\"><\/div>\n  <div class=\"particle\"><\/div>\n  <div class=\"particle\"><\/div>\n  <div class=\"particle\"><\/div>\n  <